# 将此文件复制为 backend/.env；绝不要提交真实密钥。

# OpenAI 兼容模型配置。可按需替换为其他兼容服务商。
MAIN_MODEL=deepseek-flash
MAIN_MODEL_API_KEY=
MAIN_MODEL_BASE_URL=https://api.deepseek.com
MAIN_MODEL_TEMPERATURE=0
MAIN_MODEL_MAX_TOKENS=8192
MAIN_MODEL_THINKING=disabled
MAIN_MODEL_TIMEOUT_SECONDS=60
MAIN_MODEL_MAX_RETRIES=0

# 仅供后端使用的高德 Web Service 配置。
MAP_PROVIDER=amap
AMAP_WEB_SERVICE_KEY=
AMAP_REQUEST_TIMEOUT_SECONDS=5
# 默认不读取系统 HTTP(S)_PROXY，避免本地全局代理影响高德 TLS；必须走代理时改为 true。
AMAP_USE_ENV_PROXY=false

# 默认使用离线夹具，便于首次启动；联网访问公开平台前请明确改为 live。
RENTAL_DEMO_MODE=offline

# memory 模式无需 MongoDB；进程退出后会丢失会话,需长久保存记忆请修改成mongodb
CHECKPOINT_BACKEND=memory
#CHECKPOINT_BACKEND=mongodb
# 需要跨进程或重启保留会话时改为 mongodb，并在 backend/.env 中填写真实连接信息。
# 虚拟机示例（不要把真实用户名、密码或连接 URI 提交到 Git）：
# CHECKPOINT_BACKEND=mongodb
# MONGODB_URI=mongodb://username:password@vm-ip:27017/?authSource=admin
# MONGODB_DATABASE=rental_agent

# 以下是 memory 模式下的占位值；切换 mongodb 时仍可保留数据库名。
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DATABASE=rental_agent
