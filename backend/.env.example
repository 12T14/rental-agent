# 将此文件复制为 backend/.env；绝不要提交真实密钥。

# OpenAI 兼容模型配置。可按需替换为其他兼容服务商。
MAIN_MODEL=deepseek-flash
MAIN_MODEL_API_KEY=
MAIN_MODEL_BASE_URL=https://api.deepseek.com
MAIN_MODEL_TEMPERATURE=0
MAIN_MODEL_MAX_TOKENS=8192
MAIN_MODEL_THINKING=disabled
MAIN_MODEL_TIMEOUT_SECONDS=60
MAIN_MODEL_MAX_RETRIES=0

# 仅供后端使用的高德 Web Service 配置。
MAP_PROVIDER=amap
AMAP_WEB_SERVICE_KEY=
AMAP_REQUEST_TIMEOUT_SECONDS=5

# memory 模式无需 MongoDB；进程退出后会丢失会话。
CHECKPOINT_BACKEND=memory
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DATABASE=rental_agent
